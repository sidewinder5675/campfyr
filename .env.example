# Copy this file to .env. Never commit the real keys.
NOTIFICATION_PROVIDER=pushover
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# Campfyr checks immediately at startup, then at this interval.
CHECK_INTERVAL_SECONDS=600
RECREATION_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO

# Optional protection if Campfyr is reachable beyond your trusted LAN.
CAMPFYR_USERNAME=
CAMPFYR_PASSWORD=

# Optional alternative to Pushover. Set NOTIFICATION_PROVIDER=twilio and fill all four.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
